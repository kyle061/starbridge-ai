# Recommended: python3 init-env.py --admin-email you@example.com
# Do not commit .env. Passwords are used during first initialization.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
BIND_HOST=127.0.0.1
APP_PORT=8080
TZ=Asia/Shanghai
DOMAIN=localhost
SECURITY_URL_ALLOWLIST_ENABLED=true
UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.deepseek.com,api.siliconflow.cn,openrouter.ai
ALLOW_PRIVATE_UPSTREAMS=false
ALLOW_HTTP_UPSTREAMS=false
