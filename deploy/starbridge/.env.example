# Recommended: python3 init-env.py --admin-email you@example.com
# Do not commit .env. Passwords are used during first initialization.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
BIND_HOST=127.0.0.1
APP_PORT=8080
# Optional: exact IP/CIDR of the reverse proxy directly connecting to gateway.
# Do not trust all private networks or arbitrary client-supplied forwarding headers.
# SERVER_TRUSTED_PROXIES=127.0.0.1/32
TZ=Asia/Shanghai
DOMAIN=localhost
# Domain HTTPS: keep CADDYFILE=./Caddyfile and set DOMAIN.
# Public IP HTTPS: set CADDYFILE=./Caddyfile.ip, PUBLIC_IP, and ACME_EMAIL.
CADDYFILE=./Caddyfile
PUBLIC_IP=
ACME_EMAIL=
SECURITY_URL_ALLOWLIST_ENABLED=true
UPSTREAM_HOSTS=api.openai.com,auth.openai.com,chatgpt.com,api.anthropic.com,generativelanguage.googleapis.com,api.deepseek.com,api.siliconflow.cn,openrouter.ai
ALLOW_PRIVATE_UPSTREAMS=false
ALLOW_HTTP_UPSTREAMS=false
