NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DEMO_MODE=true
# Production: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
WX_APP_ID=
WX_APP_SECRET=
# Optional access code for the browser workbench. Leave empty to disable browser login.
PREVIEW_ACCESS_KEY=
PYTHON_BIN=python3
DATA_DIR=./data
MAX_FILE_MB=200
MAX_DURATION_SECONDS=1200
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=3600
WORKER_TIMEOUT_SECONDS=600
# Optional Netscape cookies file owned by the service operator, never sent by clients.
COOKIES_FILE=
# Exact hostnames allowed for direct MP4 files. Public IPs only. Comma separated.
DIRECT_MEDIA_HOSTS=
