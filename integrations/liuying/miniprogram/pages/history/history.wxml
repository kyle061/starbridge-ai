<view class="page"><view class="row between"><view class="h1">解析记录</view><button class="icon-button" bindtap="load" aria-label="刷新"><image class="icon" src="/assets/refresh-cw.png" /></button></view><view class="muted label">{{jobs.length}} 条临时记录</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!jobs.length && !loading}}" class="empty"><image class="empty-icon" src="/assets/history.png" /><view>暂无解析记录</view></view><view wx:if="{{loading && !jobs.length}}" class="empty">正在加载</view><view wx:for="{{jobs}}" wx:key="id" class="record"><view class="record-main" data-id="{{item.id}}" bindtap="open"><view class="row between"><view class="badge">{{item.platformName}}</view><text class="tiny muted">{{item.statusText}}</text></view><view class="title">{{item.title}}</view><view class="tiny muted">{{item.timeText}} {{item.sizeText}}</view></view><button class="icon-button" data-id="{{item.id}}" bindtap="remove" aria-label="删除记录"><image class="icon" src="/assets/trash-2.png" /></button></view></view>
