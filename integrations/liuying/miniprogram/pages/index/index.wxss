.subtitle { margin-top: 18rpx; font-size: 25rpx; }.brand { width: 64rpx; height: 64rpx; flex-shrink: 0; }
.platforms { display: flex; justify-content: space-between; gap: 12rpx; margin: 48rpx 0 36rpx; }.platform { text-align: center; font-size: 20rpx; color: #78837b; }.platform-mark { margin: 0 auto 12rpx; width: 64rpx; height: 64rpx; background: #fff; border: 1rpx solid #e2e6e3; border-radius: 8rpx; color: #26352c; display: flex; align-items: center; justify-content: center; font-size: 27rpx; font-weight: 600; }
.paste { color: #197b56; gap: 8rpx; font-size: 26rpx; }.paste .icon { width: 28rpx; height: 28rpx; }
.input-wrap { border: 1rpx solid #d9e0da; background: #fff; border-radius: 8rpx; padding: 24rpx; position: relative; }.input-wrap textarea { width: 100%; height: 190rpx; padding-right: 30rpx; font-size: 28rpx; line-height: 1.7; }.clear { position: absolute; right: 4rpx; top: 6rpx; }
.segments { display: flex; padding: 8rpx; border: 1rpx solid #dce3dd; border-radius: 8rpx; background: #edf0ed; }.segments button { width: 50%; height: 72rpx; line-height: 72rpx; color: #778078; }.segments button.selected { background: #fff; color: #203f2b; box-shadow: 0 2rpx 6rpx #dce2dc; }
.consent { display: flex; gap: 6rpx; align-items: center; margin: 32rpx 0; font-size: 23rpx; color: #78837b; }.consent checkbox { transform: scale(.75); margin-left: -8rpx; }.demo { padding: 26rpx; font-size: 24rpx; }
.result { padding-top: 40rpx; margin-top: 40rpx; border-top: 1rpx solid #dce2dd; }.result video { width: 100%; height: 382rpx; background: #122019; margin: 28rpx 0 24rpx; border-radius: 8rpx; }.video-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }.details { margin-top: 14rpx; }.save { margin-top: 32rpx; }.actions { display: flex; gap: 16rpx; margin-top: 16rpx; }.actions button { flex: 1; font-size: 25rpx; }.expiry { margin-top: 24rpx; }.footnote { color: #98a098; font-size: 21rpx; text-align: center; margin-top: 40rpx; }.progress-wrap { margin-top: 28rpx; }.progress-wrap .tiny { margin-top: 16rpx; }.cancel,.retry { padding: 12rpx 0; color: #197b56; font-size: 25rpx; }
