.hero{padding:12rpx 4rpx 36rpx}.eyebrow{font-size:21rpx;letter-spacing:2rpx;color:#68746e}.brand{width:48rpx;height:48rpx}.hero .h1{margin-top:20rpx;font-size:44rpx}.subtitle{margin-top:16rpx;font-size:26rpx;line-height:1.7}.hero-tags{display:flex;gap:16rpx;margin-top:24rpx;font-size:21rpx;color:#197b56}.hero-tags text{background:#edf6f1;border-radius:8rpx;padding:8rpx 14rpx}.card{padding:28rpx;background:#fff;border:1rpx solid #e5e7eb;border-radius:24rpx}.paste{color:#197b56;gap:8rpx;font-size:26rpx;min-height:64rpx}.paste .icon{width:28rpx;height:28rpx}.input-wrap{border:1rpx solid #e5e7eb;background:#f8f9fa;border-radius:16rpx;margin-top:24rpx;position:relative;overflow:hidden}.input-wrap textarea{width:100%;height:200rpx;padding:24rpx 48rpx 24rpx 24rpx;font-size:27rpx;line-height:1.7}.clear{position:absolute;right:0;top:0}.input-note{border-top:1rpx solid #e5e7eb;padding:16rpx 24rpx;color:#6b7280;font-size:21rpx}.consent{display:flex;align-items:center;margin:24rpx 0;font-size:23rpx;color:#6b7280;line-height:1.6}.consent checkbox{transform:scale(.75);margin-left:-10rpx}.demo{padding-top:24rpx;font-size:24rpx}.platforms{display:flex;justify-content:space-between;gap:12rpx;padding:36rpx 8rpx}.platform{text-align:center;font-size:20rpx;color:#6b7280}.platform-mark{margin:0 auto 12rpx;width:60rpx;height:60rpx;background:#fff;border:1rpx solid #e5e7eb;border-radius:16rpx;color:#111;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:600}.result{margin-top:8rpx}.result video{width:100%;height:360rpx;background:#111;margin:28rpx 0 24rpx;border-radius:16rpx}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin:28rpx 0}.image-tile{min-width:0;border:1rpx solid #e5e7eb;border-radius:16rpx;overflow:hidden}.gallery-image{display:block;width:100%;height:280rpx;background:#f5f5f5}.image-caption{padding:12rpx;font-size:21rpx;color:#6b7280;gap:8rpx}.image-caption button{font-size:22rpx;color:#197b56;padding:6rpx}.video-title{font-size:30rpx;font-weight:600;line-height:1.6;word-break:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.details{margin-top:14rpx;flex-wrap:wrap}.original-note{padding:20rpx;margin-top:24rpx;font-size:23rpx;background:#f8f9fa;color:#6b7280;border-radius:12rpx;line-height:1.7}.save{margin-top:28rpx}.actions{display:flex;gap:16rpx;margin-top:16rpx}.actions button{flex:1;font-size:24rpx;padding:20rpx 10rpx}.expiry{margin-top:24rpx;text-align:center}.footnote{text-align:center;color:#6b7280;font-size:21rpx;margin-top:36rpx;line-height:1.7}.progress-wrap{margin-top:28rpx}.progress-wrap .tiny{margin-top:16rpx}.cancel,.retry{padding:12rpx 0;color:#197b56;font-size:25rpx}

.demo-row{display:flex;justify-content:center;gap:32rpx}

.gallery.single-image{grid-template-columns:minmax(0,1fr)}.single-image .gallery-image{height:560rpx}.image-caption text{white-space:nowrap;flex-shrink:0}.image-caption button{flex-shrink:0;white-space:nowrap;margin:0}
